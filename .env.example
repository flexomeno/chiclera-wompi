# Llaves de Sandbox (ambiente de pruebas) de Wompi
# Las obtienes creando una cuenta en https://comercios.wompi.co
# IMPORTANTE: usa SIEMPRE las llaves con prefijo *_test_ para hacer pruebas

WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_TU_LLAVE_PUBLICA_DE_SANDBOX
WOMPI_PRIVATE_KEY=prv_test_TU_LLAVE_PRIVADA_DE_SANDBOX
WOMPI_INTEGRITY_SECRET=test_integrity_TU_SECRETO_DE_INTEGRIDAD

# Resultado deseado en Sandbox para la transacción QR: APPROVED | DECLINED | ERROR
WOMPI_SANDBOX_STATUS=APPROVED

# Datos de la transacción de prueba
# Monto mínimo permitido por Wompi: $1,500 COP = 150000 centavos
WOMPI_AMOUNT_IN_CENTS=200000
WOMPI_CUSTOMER_EMAIL=cliente_prueba@example.com

# ──────────────────────────────────────────────────────────
# Webhook de eventos de Wompi (flujo de código offline)
# ──────────────────────────────────────────────────────────
# Dashboard de Wompi > Mi cuenta > Secretos para integración técnica
# OJO: es DISTINTO al WOMPI_INTEGRITY_SECRET de arriba.
WOMPI_EVENTS_SECRET=test_events_TU_SECRETO_DE_EVENTOS

# ──────────────────────────────────────────────────────────
# Código HOTP offline (para la Raspberry Pi sin internet)
# ──────────────────────────────────────────────────────────
# NO lo escribas a mano: ejecuta `npm run generate-secret` para generarlo.
HOTP_SECRET=
HOTP_DIGITS=6

# ──────────────────────────────────────────────────────────
# Envío de email (Gmail SMTP)
# ──────────────────────────────────────────────────────────
# Requiere verificación en 2 pasos + "Contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (NO tu contraseña normal).
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres

# ──────────────────────────────────────────────────────────
# Servidor del webhook
# ──────────────────────────────────────────────────────────
SERVER_PORT=3000
